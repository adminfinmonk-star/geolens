# core
DATA_BACKEND=postgres
DATABASE_URL=postgres://geo:geo@localhost:5432/geo
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=
PORT=3001

# collection — leave unset for zero-credential fixtures (recommended for CI)
# GEO_ADAPTER_MODE=auto|fixture|live
# GEO_COLLECTION_BACKEND=auto|openrouter|cursor|native
#   auto       = native vendor key if set, else OpenRouter, else Cursor, else fixture
#   openrouter = prefer OpenRouter for channels missing native keys
#   cursor     = prefer Cursor when CURSOR_API_KEY is set
#   native     = never use OpenRouter/Cursor; only vendor keys / fixtures
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL_OPENAI=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=http://localhost:3010
# OPENROUTER_APP_TITLE=GeoLens
# CURSOR_API_KEY=crsr_...
# CURSOR_MODEL_OPENAI=gpt-5.5
# CURSOR_MODEL_ANTHROPIC=claude-4.6-sonnet
# CURSOR_MODEL_GOOGLE=gemini-3-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# billing (optional) — omit for mock checkout that completes in-app
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# WEB_URL=http://127.0.0.1:3010
# API_URL=http://127.0.0.1:3001

# 21st MCP (UI components) — get a key at https://21st.dev/mcp
# API_KEY_21ST=

# OmniRoute (local AI gateway) — dashboard http://127.0.0.1:20128
# Provider key goes in OmniRoute (providers add), not required here for GeoLens.
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128
# OMNIROUTE_API_KEY=   # create via OmniRoute Endpoints / `omniroute api api-keys post-api-keys`

# ops
NODE_ENV=development

# design (optional) — Google Stitch export / SDK
# STITCH_API_KEY=
