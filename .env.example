# core
DATA_BACKEND=postgres
DATABASE_URL=postgres://geo:geo@localhost:5432/geo
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_API_URL=
PORT=3001

# collection — leave unset for zero-credential fixtures (recommended for CI)
# GEO_ADAPTER_MODE=auto|fixture|live
# GEO_COLLECTION_BACKEND=auto|cursor|native
#   auto   = native vendor key if set, else Cursor if CURSOR_API_KEY set, else fixture
#   cursor = prefer Cursor for all channels when CURSOR_API_KEY is set
#   native = never use Cursor; only vendor keys / fixtures
# CURSOR_API_KEY=crsr_...
# CURSOR_MODEL_OPENAI=gpt-5.5
# CURSOR_MODEL_ANTHROPIC=claude-4.6-sonnet
# CURSOR_MODEL_GOOGLE=gemini-3-flash
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# billing (optional) — omit for mock checkout that completes in-app
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# WEB_URL=http://127.0.0.1:3010
# API_URL=http://127.0.0.1:3001

# ops
NODE_ENV=development

# design (optional) — Google Stitch export / SDK
# STITCH_API_KEY=
